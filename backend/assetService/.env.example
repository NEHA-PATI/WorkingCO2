# Copernicus Data Space / Sentinel Hub OAuth (server-side only)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_SENTINEL_HUB_URL=https://sh.dataspace.copernicus.eu
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_MAX_CLOUD_COVERAGE=40
COPERNICUS_LOOKBACK_DAYS=30
COPERNICUS_CONCURRENCY=1
COPERNICUS_HISTORY_OBSERVATIONS=5
COPERNICUS_CACHE_HOURS=24
